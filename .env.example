# Copy to .env and fill. Nothing here is required to run in paper mode with
# mock quotes — the engine works out of the box.

# ── risk limits (frozen at startup, no runtime override) ─────────────────
MAX_CAPITAL=100000
MAX_POSITION_PCT=10
DAILY_LOSS_LIMIT_PCT=2
MAX_ORDERS_PER_DAY=10
ALLOW_INTRADAY=true

# ── the live gate ───────────────────────────────────────────────────────
# Live trading needs ALL THREE: this flag, a live.lock file in the repo root,
# and an interactive LIVE-CONFIRM. Leave this alone for the hackathon.
LIVE_TRADING=false

# ── Kite Connect ────────────────────────────────────────────────────────
# Used for real quotes in paper mode too. Order routing stays behind the gate.
KITE_API_KEY=
KITE_API_SECRET=

# ── Gemma ───────────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey — Gemma 4 is free tier.
# With no key and no local model, scoring falls back to a deterministic keyword
# classifier: the app still runs, and every row it touches is labelled
# model="fallback" so nothing pretends a model wrote it.
GOOGLE_API_KEY=
GEMMA_STUDIO_MODEL=gemma-4-26b-a4b-it

# auto (default) | studio | remote | ollama | stub
GEMMA_BACKEND=auto

# A GPU box on the LAN running: python -m scripts.gemma_gpu_local --serve
# GEMMA_REMOTE_URL=http://192.168.1.42:8077

# Local Ollama, if you have it: ollama pull gemma3:4b
GEMMA_OLLAMA_MODEL=gemma3:4b

# Bump this to invalidate every cached model response at once.
GEMMA_CACHE_NAMESPACE=shared

# ── data ────────────────────────────────────────────────────────────────
# 1 = never touch the network: prices and news come from data/cache, then from
# the committed fixtures. Use this for the offline demo rehearsal.
OFFLINE=0
PRICE_CACHE_TTL_HOURS=12
NEWS_CACHE_TTL_MIN=90

DATABASE_URL=sqlite:///./quantquasers.sqlite3
