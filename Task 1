from unsloth import FastModel

# Unsloth's pre-quantized Gemma 4 checkpoints — pick based on your GPU:
#   'unsloth/gemma-4-E2B-it-unsloth-bnb-4bit'  -> smallest, fastest, fits any free Colab GPU
#   'unsloth/gemma-4-E4B-it-unsloth-bnb-4bit'  -> good quality/speed balance (used below)
#   'unsloth/gemma-4-26B-A4B-it'               -> needs a bigger GPU (A100/L4)
#   'unsloth/gemma-4-31B-it-unsloth-bnb-4bit'  -> needs a bigger GPU (A100/L4)
MODEL_ID = 'unsloth/gemma-4-E4B-it-unsloth-bnb-4bit'

print(f'Loading {MODEL_ID} ...')
model, tokenizer = FastModel.from_pretrained(
    model_name=MODEL_ID,
    max_seq_length=2048,
    load_in_4bit=True,
)
FastModel.for_inference(model)  # enables Unsloth's faster inference path
print('Model loaded.')


def call_gemma(prompt: str, max_new_tokens: int = 400, temperature: float = 0.2) -> str:
    """Send a prompt to Gemma and return the generated text.

    Gemma 4 is natively multimodal, so Unsloth loads a *processor*, not a plain
    tokenizer. That means: (1) message content must be a list of typed parts,
    even for text-only prompts, and (2) apply_chat_template needs
    return_dict=True to hand back a tokenized tensor dict instead of a raw
    rendered string.
    """
    messages = [{'role': 'user', 'content': [{'type': 'text', 'text': prompt}]}]
    inputs = tokenizer.apply_chat_template(
        messages,
        add_generation_prompt=True,
        tokenize=True,
        return_dict=True,
        return_tensors='pt',
    ).to(model.device)
    output = model.generate(
        **inputs,
        max_new_tokens=max_new_tokens,
        temperature=temperature,
        do_sample=temperature > 0,
        pad_token_id=tokenizer.eos_token_id,
    )
    input_len = inputs['input_ids'].shape[-1]
    generated = output[0][input_len:]
    return tokenizer.decode(generated, skip_special_tokens=True).strip()


