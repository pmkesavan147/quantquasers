### CELL 5 — collect answers + rubric scoring
def run_quiz() -> dict:
    answers = {}
    for q in QUIZ_QUESTIONS:
        print(f"\n{q['text']}")
        if q['type'] == 'mcq':
            for key, label in q['options'].items():
                print(f'  {key}) {label}')
            while True:
                choice = input('Your answer (letter): ').strip().lower()
                if choice in q['options']:
                    answers[q['id']] = choice
                    break
                print('Please enter a valid option letter.')
        else:
            answers[q['id']] = input('Your answer: ').strip()
    return answers


def score_rubric(answers: dict) -> dict:
    total, count = 0, 0
    for q in QUIZ_QUESTIONS:
        if q['type'] == 'mcq':
            total += q['points'][answers[q['id']]]
            count += 1
    risk_score = round(total / (count * 3), 2)  # normalized 0.0 (conservative) - 1.0 (aggressive)
    return {'risk_score': risk_score}


### CELL 6 — classification via Gemma (structured JSON output)
def extract_json(text: str) -> dict:
    match = re.search(r'\{.*\}', text, re.DOTALL)
    if not match:
        raise ValueError(f'No JSON object found in model output:\n{text}')
    return json.loads(match.group(0))


CLASSIFY_PROMPT = (
    "You are classifying an investor's trading personality based on quiz answers.\n"
    'Output ONLY a valid JSON object. No explanation, no markdown formatting, no code fences.\n\n'
    'Rubric risk score (0 = very conservative, 1 = very aggressive): {risk_score}\n\n'
    'Structured answers: {mcq_answers}\n'
    'Open-ended answers:\n'
    '- Market outlook: "{open_outlook}"\n'
    '- Goal: "{open_goal}"\n\n'
    'Output format exactly:\n'
    '{{"trader_type": "long_term or swing or intraday or hybrid", '
    '"risk_tolerance": 0.0 to 1.0, '
    '"confidence": 0.0 to 1.0, '
    '"reasoning": "one sentence explanation"}}\n'
)


def classify_profile(answers: dict, rubric: dict) -> dict:
    mcq_answers = {q['id']: answers[q['id']] for q in QUIZ_QUESTIONS if q['type'] == 'mcq'}
    prompt = CLASSIFY_PROMPT.format(
        risk_score=rubric['risk_score'],
        mcq_answers=mcq_answers,
        open_outlook=answers.get('open_outlook', ''),
        open_goal=answers.get('open_goal', ''),
    )
    raw = call_gemma(prompt, max_new_tokens=200, temperature=0.1)
    try:
        result = extract_json(raw)
    except ValueError:
        # fallback if Gemma's output isn't clean JSON — never crash the pipeline
        result = {
            'trader_type': 'hybrid',
            'risk_tolerance': rubric['risk_score'],
            'confidence': 0.3,
            'reasoning': 'Fallback used: model output could not be parsed as JSON.',
        }
    # sanity check: if Gemma disagrees sharply with the hand-written rubric, lower confidence
    if abs(result.get('risk_tolerance', 0) - rubric['risk_score']) > 0.35:
        result['confidence'] = min(result.get('confidence', 0.5), 0.4)
    return result


### CELL 7 — personality report generation via Gemma (free text, not JSON)
REPORT_PROMPT = (
    'Write a friendly, plain-English investor personality report based on this profile.\n'
    'Do not use markdown headers or bullet points — write in short paragraphs.\n'
    'Keep it under 250 words. Do not give specific buy/sell advice or exact percentages.\n\n'
    'Trader type: {trader_type}\n'
    'Risk tolerance (0 = very conservative, 1 = very aggressive): {risk_tolerance}\n'
    "Model's reasoning: {reasoning}\n"
    'User\'s stated market outlook: "{open_outlook}"\n'
    'User\'s stated goal: "{open_goal}"\n\n'
    'Cover: a short overview of what this trading style means, one or two likely strengths, '
    'one potential blind spot to watch for, and one practical tip. End with a one-line reminder '
    'that this is not financial advice.\n'
)


def generate_personality_report(profile: dict, answers: dict) -> str:
    prompt = REPORT_PROMPT.format(
        trader_type=profile['trader_type'],
        risk_tolerance=profile['risk_tolerance'],
        reasoning=profile.get('reasoning', ''),
        open_outlook=answers.get('open_outlook', ''),
        open_goal=answers.get('open_goal', ''),
    )
    return call_gemma(prompt, max_new_tokens=400, temperature=0.4)


### CELL 8 — run everything
if __name__ == '__main__':
    user_answers = run_quiz()
    rubric_result = score_rubric(user_answers)
    user_profile = classify_profile(user_answers, rubric_result)

    print('\n' + '=' * 50)
    print('CLASSIFICATION')
    print('=' * 50)
    print(json.dumps(user_profile, indent=2))

    personality_report = generate_personality_report(user_profile, user_answers)

    print('\n' + '=' * 50)
    print('PERSONALITY REPORT')
    print('=' * 50)
    print(textwrap.fill(personality_report, width=80))
